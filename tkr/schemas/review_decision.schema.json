{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cockpit.test/schemas/review_decision.schema.json",
  "title": "TKR-Lite Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "decision_id", "revision", "decision_type", "subject_refs", "question", "outcome", "rationale", "evidence_refs", "actor", "actor_role", "decided_at", "status", "follow_up"],
  "properties": {
    "schema_id": {"const": "review-decision/v1"},
    "decision_id": {"type": "string", "pattern": "^DEC-TKR-[0-9]{4}$"},
    "revision": {"type": "integer", "minimum": 1},
    "decision_type": {"enum": ["sampling", "knowledge_boundary", "scope", "classification", "promotion", "waiver", "publication"]},
    "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "question": {"type": "string", "minLength": 5},
    "outcome": {"type": "string", "minLength": 2},
    "rationale": {"type": "string", "minLength": 5},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "actor": {"type": "string"},
    "actor_role": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["recorded", "pending_human_approval", "approved", "rejected", "superseded"]},
    "follow_up": {"type": "array", "items": {"type": "string"}},
    "object_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
